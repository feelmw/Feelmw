<div class="modal-backdrop-app" @onclick="CancelAsync">
    <div class="modal-card-app document-header-modal" @onclick:stopPropagation="true">
        <h2>Dokumentuaren datuak</h2>
        <p class="form-help">Eremu hutsak dokumentuan ??? gisa markatuko dira.</p>

        <div class="form-grid section-grid">
            <label>Maila <InputText class="form-control" @bind-Value="Model.Maila" /></label>
            <label>Ikastetxea <InputText class="form-control" @bind-Value="Model.Ikastetxea" /></label>
            <label>Datak <InputText class="form-control" @bind-Value="Model.Datak" /></label>
            <label>Ibilbidea <InputText class="form-control" @bind-Value="Model.Ibilbidea" /></label>
            <label>Irakasle kopurua <InputText class="form-control" @bind-Value="Model.Irakasleak" /></label>
            <label>Begirale kopurua <InputText class="form-control" @bind-Value="Model.Begiraleak" /></label>
            <label>Ikasle kopurua <InputText class="form-control" @bind-Value="Model.Ikasleak" /></label>
            <label>Autobus gidari kopurua <InputText class="form-control" @bind-Value="Model.Gidariak" /></label>
            <label>Ikasleen poliza zenbakia <InputText class="form-control" @bind-Value="Model.PolizaIkasleak" /></label>
            <label>Begiraleen poliza zenbakia <InputText class="form-control" @bind-Value="Model.PolizaBegiraleak" /></label>
        </div>

        <div class="actions left modal-actions-app">
            <button class="btn btn-primary" type="button" @onclick="SaveAsync">Sortu dok.</button>
            <button class="btn btn-secondary" type="button" @onclick="CancelAsync">Utzi</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DocumentHeaderData Model { get; set; } = new();

    [Parameter, EditorRequired]
    public EventCallback<DocumentHeaderData> OnSave { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnCancel { get; set; }

    private Task SaveAsync()
    {
        return OnSave.InvokeAsync(Model.Clone());
    }

    private Task CancelAsync()
    {
        return OnCancel.InvokeAsync();
    }
}
