@page "/logistika-db"
@inject ILogistikaDbService DbService
@inject IJSRuntime JS

<PageTitle>FeelMW - LogistikaDB</PageTitle>

<SectionHeader Title="LogistikaDB" Subtitle="Logistika.xlsx" />

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">@message</div>
}

<div class="alert alert-info">Fitxategia ezin da zuzenean aldatu nabigatzailetik. Aldaketak nabigatzailean gordeko dira.</div>

<div class="toolbar">
    <select class="form-select" @bind="selectedSheet" @bind:after="LoadAsync">
        <option value="Ostalak">Ostalak</option>
        <option value="Ekintzak">Ekintzak</option>
    </select>
    <button class="btn btn-primary" @onclick="SaveAsync">Gorde</button>
</div>

@if (headers.Count == 0)
{
    <EmptyState Title="Daturik ez" Message="Orria hutsik dago." />
}
else
{
    <div class="db-table-wrap">
        <table class="table data-table logistika-db-table">
            <thead>
                <tr>
                    @foreach (string header in headers)
                    {
                        <th>@DisplayHeader(header)</th>
                    }
                    <th>Ekintzak</th>
                </tr>
            </thead>
            <tbody>
                @for (int rowIndex = 0; rowIndex < rows.Count; rowIndex++)
                {
                    int currentRow = rowIndex;
                    <tr>
                        @for (int colIndex = 0; colIndex < headers.Count; colIndex++)
                        {
                            int currentCol = colIndex;
                            <td>
                                <input class="form-control db-cell-input" value="@rows[currentRow][currentCol]" @oninput="e => UpdateCell(currentRow, currentCol, e.Value?.ToString() ?? string.Empty)" />
                            </td>
                        }
                        <td>
                            @if (currentRow < existingRowCount)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRowAsync(currentRow)">Ezabatu</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string selectedSheet = "Ostalak";
    private List<string> headers = [];
    private List<List<string>> rows = [];
    private string? message;
    private int existingRowCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IReadOnlyList<IReadOnlyList<string>> sheetRows = await DbService.ReadSheetAsync(selectedSheet);
        if (sheetRows.Count == 0)
        {
            headers = [];
            rows = [];
            existingRowCount = 0;
            message = null;
            return;
        }

        headers = sheetRows[0]
            .Select((header, index) => string.IsNullOrWhiteSpace(header) ? $"Zutabe {index + 1}" : header)
            .ToList();
        rows = NormalizeRows(sheetRows.Skip(1).ToList(), headers.Count);
        existingRowCount = rows.Count;
        AddBlankRow();
        message = null;
    }

    private void AddBlankRow()
    {
        rows.Add(Enumerable.Repeat("", headers.Count).ToList());
    }

    private async Task SaveAsync()
    {
        try
        {
            await SaveRowsAsync();
            await LoadAsync();
            message = "Gordeta.";
        }
        catch
        {
            message = "Ezin izan da fitxategia eguneratu.";
        }
    }

    private async Task DeleteRowAsync(int rowIndex)
    {
        if (rowIndex < 0 || rowIndex >= existingRowCount)
        {
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Ziur zaude errenkada hau ezabatu nahi duzula?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            rows.RemoveAt(rowIndex);
            await SaveRowsAsync();
            await LoadAsync();
            message = "Ezabatuta.";
        }
        catch
        {
            message = "Ezin izan da fitxategia eguneratu.";
        }
    }

    private async Task SaveRowsAsync()
    {
        List<List<string>> rowsToSave =
        [
            headers,
            .. rows
                .Where(row => row.Any(cell => !string.IsNullOrWhiteSpace(cell)))
                .Select(row => row.ToList())
        ];

        await DbService.SaveSheetAsync(selectedSheet, rowsToSave);
    }

    private void UpdateCell(int row, int col, string value)
    {
        rows[row][col] = value;
    }

    private static string DisplayHeader(string header)
    {
        return NormalizeHeader(header) switch
        {
            "checkin" => "Sarrera",
            "checkout" => "Irteera",
            "doku" or "doc" => "Dokumentazioa",
            "harretaordutegia" or "harreraordutegia" => "Harrera ordutegia",
            "toallakbarne" or "toailakbarne" => "Toailak barne",
            "luggageprezioa" or "luggagekuota" or "luggagequota" => "Maleten prezioa",
            "fidantzaprezioa" or "fidantzakuota" => "Fidantza prezioa",
            "ekintzaizena" => "Ekintzaren izena",
            "garraioaizena" => "Garraioaren izena",
            "lokali" => "Lokala",
            "bertanm" => "Bertan emandako materiala",
            "eramanm" => "Eraman beharreko materiala",
            _ => header
        };
    }

    private static string NormalizeHeader(string value)
    {
        return new string((value ?? "")
            .Trim()
            .ToLowerInvariant()
            .Where(char.IsLetterOrDigit)
            .ToArray());
    }

    private static List<List<string>> NormalizeRows(IReadOnlyList<IReadOnlyList<string>> sourceRows, int columns)
    {
        return sourceRows
            .Select(row =>
            {
                List<string> values = row.Take(columns).ToList();
                while (values.Count < columns)
                {
                    values.Add("");
                }

                return values;
            })
            .ToList();
    }
}
