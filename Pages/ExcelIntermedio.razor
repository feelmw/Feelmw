@page "/excel-intermedio"
@inject IExcelInfrastructureService ExcelService
@inject IDocumentWorkflowService WorkflowService

<PageTitle>FeelMW - Excel</PageTitle>

<SectionHeader Title="Sortu tarteko Excel" Subtitle="Excelerako azpiegitura prest" />

<div class="action-panel">
    <p>Jatorrizko logika migratzean tarteko Excel fitxategia sortzeko prest.</p>
    <button class="btn btn-primary" @onclick="CrearAsync">Sortu tarteko Excel</button>
</div>

@code {
    private async Task CrearAsync()
    {
        await ExcelService.CreateIntermediateWorkbookAsync();
        await WorkflowService.CreateIntermediateExcelAsync();
    }
}
