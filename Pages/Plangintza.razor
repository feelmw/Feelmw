@page "/plangintza"
@inject PlangintzaWorkflowState State
@inject IPlangintzaListakService ListakService
@inject IPlangintzaExcelService ExcelService
@inject IPlangintzaDocumentService DocumentService
@inject NavigationManager Nav

<PageTitle>FeelMW - Plangintza</PageTitle>

<SectionHeader Title="Plangintza" Subtitle="Hotelak, egunak eta ekintzak" />

@foreach (string mezua in State.Mezuak.Distinct())
{
    <div class="alert alert-info">@mezua</div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">
        <div>@message</div>
        @if (!string.IsNullOrWhiteSpace(lastDriveLink))
        {
            <a href="@lastDriveLink" target="_blank" rel="noopener">Drive-n ireki</a>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="plangintza-board">
    <section class="plangintza-panel">
        <div class="form-grid">
            <label>Dokumentua <InputText class="form-control" @bind-Value="documentName" /></label>
            <label>
                Ostatua / hotela
                <select class="form-select" value="@hotelName" @onchange="HotelSelected">
                    <option value="">Aukeratu ostala</option>
                    @foreach (Hotelak item in hotelPresets)
                    {
                        <option value="@item.Izena">@item.Izena</option>
                    }
                </select>
            </label>
            <label>Hiria <input class="form-control" @bind="hiria" @bind:event="oninput" /></label>
            <label>Helbidea / URLa <input class="form-control" @bind="helbideaUrl" @bind:event="oninput" /></label>
            <label>Egun kopurua <input type="number" class="form-control" value="@egunKop" min="1" @oninput="OnEgunKopInput" /></label>
        </div>
    </section>

    <section class="plangintza-panel">
        <h2>Goiko taula</h2>
        <div class="db-table-wrap">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Eguna</th>
                        <th>Data</th>
                        <th>Goiza</th>
                        <th>Arratsaldea</th>
                        <th>Gaua</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < egunak.Count; i++)
                    {
                        int index = i;
                        <tr>
                            <td>@egunak[index].Eguna</td>
                            <td><input type="text" class="form-control" @bind="egunak[index].Data" @bind:event="oninput" /></td>
                            <td><input class="form-control" @bind="egunak[index].Goisa" @bind:event="oninput" /></td>
                            <td><input class="form-control" @bind="egunak[index].Arratsaldea" @bind:event="oninput" /></td>
                            <td><input class="form-control" @bind="egunak[index].Gaua" @bind:event="oninput" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="plangintza-panel">
        <div class="section-title-row">
            <h2>Egunez eguneko plangintza</h2>
            <div class="actions left">
                <button class="btn btn-outline-primary" @onclick="AddActivity">+ Ekintza</button>
                <button class="btn btn-outline-secondary" @onclick="ShowAddMotaModal">+ Mota</button>
            </div>
        </div>
        <div class="db-table-wrap">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Eguna</th>
                        <th>Ordua</th>
                        <th>Mota</th>
                        <th>Deskribapena</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < ekintzak.Count; i++)
                    {
                        int index = i;
                        <tr>
                            <td>
                                <InputSelect class="form-select" @bind-Value="ekintzak[index].Eguna">
                                    @foreach (string eguna in DayOptions)
                                    {
                                        <option value="@eguna">@eguna</option>
                                    }
                                </InputSelect>
                            </td>
                            <td><input class="form-control" @bind="ekintzak[index].Ordua" @bind:event="oninput" /></td>
                            <td><input class="form-control" list="mota-list" @bind="ekintzak[index].Mota" @bind:event="oninput" @onchange="() => ActivityTypeSelected(index)" /></td>
                            <td><input class="form-control" @bind="ekintzak[index].Deskribapena" @bind:event="oninput" /></td>
                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteActivity(index)">Ezabatu</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <datalist id="mota-list">
            @foreach (EkintzakPlan item in activityPresets)
            {
                <option value="@item.Mota"></option>
            }
        </datalist>
    </section>

    <section class="plangintza-panel">
        <div class="summary-line">
            <span>Hotelak: @State.Bidaiak.Count</span>
            <span>Egunak: @State.Bidaiak.Sum(b => b.EgunLaburpenak.Count)</span>
            <span>Ekintzak: @State.Bidaiak.Sum(b => b.EkintzaDatuak.Count)</span>
        </div>
        <div class="actions left">
            <NavLink class="btn btn-outline-primary" href="plangintza/datuak">Datuak ikusi</NavLink>
            <button class="btn btn-primary" @onclick="SaveToList">Zerrendara</button>
            <button class="btn btn-outline-primary" @onclick="ShowDocumentHeaderForm">Sortu dok.</button>
            <button class="btn btn-outline-primary" @onclick="CreateExcelAsync">Gorde</button>
            <button class="btn btn-secondary" @onclick="Exit">Irten</button>
        </div>
    </section>
</div>

@if (showAddMotaModal)
{
    <div class="modal-backdrop-app" @onclick="CloseAddMotaModal">
        <div class="modal-card-app" @onclick:stopPropagation="true">
            <h2>Ekintza berria gehitu</h2>

            @if (!string.IsNullOrWhiteSpace(addMotaError))
            {
                <div class="alert alert-danger">@addMotaError</div>
            }

            <label>
                Izena
                <InputText class="form-control" @bind-Value="newMotaIzena" />
            </label>
            <label>
                Deskribapena
                <InputTextArea class="form-control" @bind-Value="newMotaDeskribapena" />
            </label>
            <div class="actions left modal-actions-app">
                <button class="btn btn-primary" @onclick="SaveMotaAsync" disabled="@savingMota">Gorde</button>
                <button class="btn btn-secondary" @onclick="CloseAddMotaModal" disabled="@savingMota">Utzi</button>
            </div>
        </div>
    </div>
}

@if (showDocumentHeaderForm)
{
    <DocumentHeaderForm Model="documentHeaderData" OnSave="CreateDocumentAsync" OnCancel="CloseDocumentHeaderForm" />
}

@if (pendingDriveFile is not null)
{
    <FSeleccionarDrive FileName="@pendingDriveFile.FileName"
                       ContentType="@pendingDriveFile.ContentType"
                       Content="@pendingDriveFile.Content"
                       OnSaved="OnDriveSavedAsync"
                       OnCancel="CancelDriveSaveAsync"
                       OnFallbackDownloaded="OnFallbackDownloadedAsync" />
}

@code {
    private List<Hotelak> hotelPresets = [];
    private List<EkintzakPlan> activityPresets = [];
    private string documentName = "MyFeelPlangintza";
    private string hotelName = "";
    private string hiria = "";
    private string helbideaUrl = "";
    private int egunKop = 1;
    private DateTime startDate = DateTime.Today;
    private List<EgunLaburpena> egunak = [];
    private List<EkintzaDatuak> ekintzak = [];
    private string? message;
    private string? error;
    private bool showAddMotaModal;
    private bool savingMota;
    private string newMotaIzena = "";
    private string newMotaDeskribapena = "";
    private string? addMotaError;
    private bool showDocumentHeaderForm;
    private DocumentHeaderData documentHeaderData = new();
    private GeneratedFileData? pendingDriveFile;
    private string lastDriveLink = "";
    private List<string> DayOptions => egunak.Count == 0
        ? ["Eguna1"]
        : egunak.Select(e => string.IsNullOrWhiteSpace(e.Data) ? $"Eguna{e.Eguna}" : e.Data).ToList();

    protected override async Task OnInitializedAsync()
    {
        documentName = State.DokumentuIzena;

        try
        {
            PlangintzaListak listak = await ListakService.ReadAllAsync();
            hotelPresets = listak.Ostalak;
            activityPresets = listak.Ekintzak;
        }
        catch
        {
            hotelPresets = [];
            activityPresets = [];
        }

        EnsureDays();
        AddActivity();
    }

    private void HotelSelected(ChangeEventArgs _)
    {
        hotelName = _?.Value?.ToString() ?? "";
        Hotelak? selected = hotelPresets.FirstOrDefault(h => string.Equals(h.Izena, hotelName, StringComparison.OrdinalIgnoreCase));
        if (selected is null)
        {
            hiria = "";
            helbideaUrl = "";
            return;
        }

        hiria = selected.Hiria;
        helbideaUrl = selected.HelbideaUrl;
    }

    private void OnEgunKopInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int value))
        {
            egunKop = Math.Max(1, value);
            EnsureDays();
        }
    }

    private void EnsureDays()
    {
        egunKop = Math.Max(1, egunKop);
        while (egunak.Count < egunKop)
        {
            int num = egunak.Count + 1;
            egunak.Add(new EgunLaburpena(num, startDate.AddDays(num - 1).ToShortDateString(), "", "", ""));
        }

        while (egunak.Count > egunKop)
        {
            EgunLaburpena removed = egunak[^1];
            egunak.RemoveAt(egunak.Count - 1);
            ekintzak.RemoveAll(e => e.Eguna == removed.Data || e.Eguna == $"Eguna{removed.Eguna}");
        }

        for (int i = 0; i < egunak.Count; i++)
        {
            egunak[i].Eguna = i + 1;
        }
    }

    private void AddActivity()
    {
        string day = DayOptions.FirstOrDefault() ?? "Eguna1";
        ekintzak.Add(new EkintzaDatuak(day, DateTime.Now.ToShortTimeString(), "", ""));
    }

    private void DeleteActivity(int index)
    {
        if (index >= 0 && index < ekintzak.Count)
        {
            ekintzak.RemoveAt(index);
        }
    }

    private void ActivityTypeSelected(int index)
    {
        if (index < 0 || index >= ekintzak.Count)
        {
            return;
        }

        EkintzakPlan? selected = activityPresets.FirstOrDefault(e => string.Equals(e.Mota, ekintzak[index].Mota, StringComparison.OrdinalIgnoreCase));
        if (selected is not null)
        {
            ekintzak[index].Deskribapena = selected.Deskribapena;
        }
    }

    private void ShowAddMotaModal()
    {
        message = null;
        error = null;
        addMotaError = null;
        showAddMotaModal = true;
    }

    private void CloseAddMotaModal()
    {
        if (savingMota)
        {
            return;
        }

        showAddMotaModal = false;
        ClearMotaModal();
    }

    private async Task SaveMotaAsync()
    {
        addMotaError = null;
        message = null;
        error = null;

        string izena = newMotaIzena.Trim();
        if (string.IsNullOrWhiteSpace(izena))
        {
            addMotaError = "Izena derrigorrezkoa da.";
            return;
        }

        try
        {
            savingMota = true;
            EkintzakPlan plan = new(izena, newMotaDeskribapena.Trim());
            await ListakService.AddEkintzaAsync(plan);
            activityPresets = (await ListakService.ReadEkintzakAsync()).ToList();
            showAddMotaModal = false;
            ClearMotaModal();
            message = "Ekintza behar bezala gehitu da.";
        }
        catch
        {
            addMotaError = "Ezin izan da ekintza gehitu.";
        }
        finally
        {
            savingMota = false;
        }
    }

    private void ClearMotaModal()
    {
        newMotaIzena = "";
        newMotaDeskribapena = "";
        addMotaError = null;
    }

    private void SaveToList()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(hotelName))
        {
            error = "Aukeratu edo idatzi hotel bat.";
            return;
        }

        EnsureDays();
        Hotelak hotel = new(hiria, hotelName, helbideaUrl);
        List<EkintzaDatuak> cleanActivities = ekintzak
            .Where(e => !string.IsNullOrWhiteSpace(e.Mota) || !string.IsNullOrWhiteSpace(e.Deskribapena))
            .Select(e => new EkintzaDatuak(e.Eguna, e.Ordua, e.Mota, e.Deskribapena))
            .ToList();
        Bidaiak bidaia = new(
            hotel,
            egunKop,
            egunak.Select(e => new EgunLaburpena(e.Eguna, e.Data, e.Goisa, e.Arratsaldea, e.Gaua)).ToList(),
            cleanActivities);

        State.DokumentuIzena = BuildDocumentName();
        State.UpsertBidaia(bidaia);
        message = "Bidaia zerrendara gehituta.";
    }

    private Task CreateExcelAsync()
    {
        try
        {
            SaveToList();
            if (!string.IsNullOrWhiteSpace(error))
            {
                return Task.CompletedTask;
            }

            byte[] bytes = ExcelService.CreateWorkbook(State.Bidaiak);
            PrepareDriveSave($"{OutputFileBaseName("Plangintza")}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        catch
        {
            message = "Errorea fitxategia sortzean.";
        }

        return Task.CompletedTask;
    }

    private void ShowDocumentHeaderForm()
    {
        documentHeaderData = BuildDefaultDocumentHeaderData();
        showDocumentHeaderForm = true;
    }

    private void CloseDocumentHeaderForm()
    {
        showDocumentHeaderForm = false;
    }

    private async Task CreateDocumentAsync(DocumentHeaderData headerData)
    {
        showDocumentHeaderForm = false;
        SaveToList();
        if (!string.IsNullOrWhiteSpace(error))
        {
            return;
        }

        State.Ikastetxea = headerData.IkastetxeaOsatua;
        const string templatePath = "templates/Plangintza.docx";
        DocumentGenerationResult result = await DocumentService.CreateDocumentFromTemplatePathAsync(templatePath, State.Bidaiak, State.DokumentuIzena, State.Ikastetxea, headerData);
        State.Mezuak.Clear();
        State.Mezuak.AddRange(result.Warnings);
        State.Mezuak.AddRange(result.Errors);
        if (!result.Success || result.Content.Length == 0)
        {
            message = result.Errors.Count == 0 ? "Ezin izan da dokumentua sortu." : string.Join(" ", result.Errors);
            return;
        }

        PrepareDriveSave($"{OutputFileBaseName("Plangintza")}.docx", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", result.Content);
    }

    private void PrepareDriveSave(string fileName, string contentType, byte[] bytes)
    {
        lastDriveLink = "";
        pendingDriveFile = new GeneratedFileData
        {
            FileName = fileName,
            ContentType = contentType,
            Content = bytes
        };
        message = "Aukeratu Google Drive karpeta fitxategia gordetzeko.";
    }

    private Task OnDriveSavedAsync(DriveSaveResult result)
    {
        pendingDriveFile = null;
        lastDriveLink = result.WebViewLink;
        message = $"Fitxategia Drive-n gorde da: {result.FileName}. Karpeta: {result.FolderName}.";
        CleanAndExit();
        return Task.CompletedTask;
    }

    private Task CancelDriveSaveAsync()
    {
        pendingDriveFile = null;
        lastDriveLink = "";
        message = "Ez da karpetarik aukeratu; gordetzea bertan behera utzi da.";
        return Task.CompletedTask;
    }

    private Task OnFallbackDownloadedAsync(string fileName)
    {
        pendingDriveFile = null;
        lastDriveLink = "";
        message = $"Drive-k errorea eman duenez, fitxategia deskargatu da: {fileName}.";
        CleanAndExit();
        return Task.CompletedTask;
    }

    private string OutputFileBaseName(string prefix)
    {
        return BuildDocumentName(prefix);
    }

    private string BuildDocumentName(string prefix = "Plangintza")
    {
        string cleanName = Path.GetFileNameWithoutExtension(documentName.Trim());
        if (cleanName.StartsWith($"{prefix} - ", StringComparison.OrdinalIgnoreCase))
        {
            return cleanName;
        }

        if (string.IsNullOrWhiteSpace(cleanName))
        {
            return prefix;
        }

        return $"{prefix} - {cleanName}";
    }

    private DocumentHeaderData BuildDefaultDocumentHeaderData()
    {
        return new DocumentHeaderData
        {
            Ikastetxea = State.Ikastetxea,
            Datak = string.Join(", ", egunak.Select(e => e.Data).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct()),
            Ibilbidea = string.IsNullOrWhiteSpace(hiria) ? documentName.Trim() : hiria
        };
    }

    private void Exit()
    {
        CleanAndExit();
    }

    private void CleanAndExit()
    {
        State.Clear();
        State.DokumentuIzena = "";
        State.Ikastetxea = "";
        ClearForm(addInitialRows: false);
        Nav.NavigateTo("");
    }

    private void ClearForm(bool addInitialRows = true)
    {
        documentName = "";
        hotelName = "";
        hiria = "";
        helbideaUrl = "";
        egunKop = 1;
        startDate = DateTime.Today;
        egunak = [];
        ekintzak = [];
        error = null;
        message = null;
        if (addInitialRows)
        {
            EnsureDays();
            AddActivity();
        }
    }

}
