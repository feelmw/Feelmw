@page "/datuak"
@inject ILogistikaService LogistikaService
@inject IPlangintzaService PlangintzaService

<PageTitle>FeelMW - Datuak</PageTitle>

<SectionHeader Title="Gordetako datuak ikusi" Subtitle="Gordetako datuak irakurtzeko ikuspegia" />

<div class="workflow-grid">
    <section>
        <h2>Logistika</h2>
        <EmptyState Message="Gordetako ostatuak, ekintzak eta garraioak konektatzeko dago." />
    </section>
    <section>
        <h2>Plangintza</h2>
        <EmptyState Message="Gordetako bidaiak, egunak eta hotelak konektatzeko dago." />
    </section>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await LogistikaService.GetOstalakAsync();
        await PlangintzaService.GetBidaiakAsync();
    }
}
