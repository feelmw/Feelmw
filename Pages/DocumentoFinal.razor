@page "/dokumentua-final"
@inject IDocumentTemplateService TemplateService
@inject IDocumentWorkflowService WorkflowService

<PageTitle>FeelMW - Dokumentua</PageTitle>

<SectionHeader Title="Sortu azken dokumentua txantiloitik" Subtitle="Txantiloietarako azpiegitura prest" />

<div class="action-panel">
    <p>Jatorrizko logika migratzean azken dokumentua txantiloitik sortzeko prest.</p>
    <button class="btn btn-primary" @onclick="CrearAsync">Sortu azken dokumentua</button>
</div>

@code {
    private async Task CrearAsync()
    {
        await TemplateService.CreateDocumentFromTemplateAsync();
        await WorkflowService.CreateFinalDocumentFromTemplateAsync();
    }
}
